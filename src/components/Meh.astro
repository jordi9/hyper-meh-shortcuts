---
/**
 * Inline Meh layer icon (Lucide sparkle).
 * Usage: <Meh /> or <Meh key="U" />
 */
interface Props {
  key?: string;
}
const { key } = Astro.props;
---
<span class="layer-icon meh"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>{key && <code>{key}</code>}</span>

<style>
  .layer-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    vertical-align: baseline;
  }
  .layer-icon svg {
    display: inline-block;
    vertical-align: -0.15em;
  }
</style>
